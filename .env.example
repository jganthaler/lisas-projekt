APP_NAME=Coolventory
APP_ENV=local
# Generate a fresh application key with:
#   docker compose exec laravel.test php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Only needed on Windows: the Sail image is built with this user/group id.
# WWWUSER=1000
# WWWGROUP=1000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is provided by the Sail service "mysql" (see compose.yaml).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=coolventory
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes every mail to storage/logs/laravel.log, so the
# confirmation and password mails can be read there without a real mailbox.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Rechtliches (Impressum, Datenschutzerklärung, Nutzungsbedingungen) ------
# Diese Angaben stehen im Impressum und in der Datenschutzerklärung
# (config/legal.php, App\Support\Legal). Solange Name, Anschrift und E-Mail
# fehlen, zeigt das Impressum einen Warnhinweis an - die Anwendung soll nicht
# ohne Impressum veröffentlicht werden können.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_STREET=
LEGAL_OPERATOR_CITY=
LEGAL_OPERATOR_COUNTRY=Deutschland
LEGAL_OPERATOR_EMAIL=
# Optional: Nach § 5 DDG genügt die E-Mail-Adresse als Kontaktmöglichkeit.
LEGAL_OPERATOR_PHONE=

# Hoster und Mail-Dienst erscheinen in der Datenschutzerklärung als Empfänger
# der Daten. Für beide braucht es einen Auftragsverarbeitungsvertrag
# (Art. 28 DSGVO) - bei Hostern und Mail-Diensten meist Teil der AGB.
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATION=
LEGAL_MAIL_PROVIDER=
LEGAL_MAIL_LOCATION=

# Datum der letzten Änderung der Rechtstexte (JJJJ-MM-TT), steht unter jeder
# der drei Seiten. Leer lassen, dann entfällt die Zeile.
LEGAL_UPDATED_AT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
